+/**
+ *  CellStyleDialog.js
+ *
+ *  Edits a cell style: name, font, colors, borders, alignment and number format.
+ *  Returns the name and an Asc.asc_CellXfs; only the fields the user changed are
+ *  set on that xfs, the rest stays as the style (or the selection) had it.
+ */
+
+define([
+    'common/main/lib/view/AdvancedSettingsWindow'
+], function () { 'use strict';
+
+    SSE.Views.CellStyleDialog = Common.Views.AdvancedSettingsWindow.extend(_.extend({
+        options: {
+            contentWidth: 330,
+            separator: false,
+            id: 'window-cell-style'
+        },
+
+        initialize : function(options) {
+            var me = this;
+
+            this.isModify = !!options.isModify;
+            _.extend(this.options, {
+                title: this.isModify ? this.textTitleModify : this.textTitleNew,
+                contentStyle: 'padding: 5px 5px 0;',
+                contentTemplate: _.template([
+                    '<div class="settings-panel active">',
+                        '<div class="inner-content">',
+                            '<table cols="2" style="width: 100%;">',
+                                '<tr><td colspan="2"><label class="input-label">' + me.textName + '</label></td></tr>',
+                                '<tr><td colspan="2" class="padding-small"><div id="cell-style-name"></div></td></tr>',
+                                '<tr><td colspan="2"><label class="input-label">' + me.textFont + '</label></td></tr>',
+                                '<tr><td colspan="2" class="padding-small">',
+                                    '<div id="cell-style-font" style="display: inline-block; vertical-align: middle;"></div>',
+                                    '<div id="cell-style-font-size" style="display: inline-block; vertical-align: middle; margin: 0 4px;"></div>',
+                                '</td></tr>',
+                                '<tr><td colspan="2" class="padding-small">',
+                                    '<div id="cell-style-bold" style="display: inline-block;"></div>',
+                                    '<div id="cell-style-italic" style="display: inline-block;"></div>',
+                                    '<div id="cell-style-underline" style="display: inline-block;"></div>',
+                                    '<div id="cell-style-text-color" style="display: inline-block; margin: 0 4px;"></div>',
+                                    '<div id="cell-style-fill-color" style="display: inline-block;"></div>',
+                                '</td></tr>',
+                                '<tr><td colspan="2"><label class="input-label">' + me.textBorders + '</label></td></tr>',
+                                '<tr><td colspan="2" class="padding-small"><div id="cell-style-borders"></div></td></tr>',
+                                '<tr>',
+                                    '<td style="width: 50%;"><label class="input-label">' + me.textHorizontal + '</label></td>',
+                                    '<td><label class="input-label">' + me.textVertical + '</label></td>',
+                                '</tr>',
+                                '<tr>',
+                                    '<td class="padding-small"><div id="cell-style-halign"></div></td>',
+                                    '<td class="padding-small"><div id="cell-style-valign"></div></td>',
+                                '</tr>',
+                                '<tr><td colspan="2" class="padding-small"><div id="cell-style-wrap"></div></td></tr>',
+                                '<tr><td colspan="2"><label class="input-label">' + me.textNumberFormat + '</label></td></tr>',
+                                '<tr><td colspan="2" class="padding-small">',
+                                    '<div id="cell-style-format" style="display: inline-block; vertical-align: middle;"></div>',
+                                    '<button type="button" class="btn btn-text-default auto" id="cell-style-format-change" style="vertical-align: middle; margin: 0 4px;">' + me.textChange + '</button>',
+                                '</td></tr>',
+                            '</table>',
+                        '</div></div>'
+                ].join(''))({scope: this})
+            }, options);
+
+            this.api      = options.api;
+            this.fontStore = options.fontStore;
+            this.langId   = options.langId;
+            this.name     = options.name;
+            this.xfs      = options.xfs;
+
+            this.options.handler = function(result, settings) {
+                if (result === 'ok' && !this.isNameValid()) {
+                    return true;
+                }
+                options.handler && options.handler.call(this, result, settings);
+            };
+
+            Common.Views.AdvancedSettingsWindow.prototype.initialize.call(this, this.options);
+        },
+
+        render: function() {
+            Common.Views.AdvancedSettingsWindow.prototype.render.call(this);
+            var me = this;
+
+            this.txtName = new Common.UI.InputField({
+                el          : $('#cell-style-name'),
+                style       : 'width: 100%;',
+                validateOnBlur: false,
+                hideErrorOnInput: true,
+                disabled    : this.isModify
+            });
+
+            this.cmbFont = new Common.UI.ComboBoxFonts({
+                el          : $('#cell-style-font'),
+                cls         : 'input-group-nr',
+                style       : 'width: 200px;',
+                menuCls     : 'scrollable-menu',
+                menuStyle   : 'min-width: 100%;max-height: 270px;',
+                store       : new Common.Collections.Fonts(),
+                recent      : 0,
+                hint        : this.textFont
+            });
+            this.cmbFont.on('selected', function(combo, record) {
+                me.fontName = record.name;
+            });
+
+            this.cmbFontSize = new Common.UI.ComboBox({
+                el          : $('#cell-style-font-size'),
+                cls         : 'input-group-nr',
+                style       : 'width: 55px;',
+                menuCls     : 'scrollable-menu',
+                menuStyle   : 'min-width: 55px;max-height: 270px;',
+                hint        : this.textSize,
+                data        : [8, 9, 10, 11, 12, 14, 16, 18, 20, 22, 24, 26, 28, 36, 48, 72].map(function(size) {
+                    return {value: size, displayValue: String(size)};
+                })
+            });
+
+            this.btnBold = this.createToggle('#cell-style-bold', 'btn-bold', this.textBold);
+            this.btnItalic = this.createToggle('#cell-style-italic', 'btn-italic', this.textItalic);
+            this.btnUnderline = this.createToggle('#cell-style-underline', 'btn-underline', this.textUnderline);
+
+            this.btnTextColor = this.createColorButton('#cell-style-text-color', 'btn-fontcolor', this.textColor, false);
+            this.btnFillColor = this.createColorButton('#cell-style-fill-color', 'btn-paracolor', this.textFill, true);
+
+            this.cmbBorders = new Common.UI.ComboBox({
+                el          : $('#cell-style-borders'),
+                cls         : 'input-group-nr',
+                style       : 'width: 100%;',
+                menuStyle   : 'min-width: 100%;',
+                editable    : false,
+                data        : [
+                    {value: 'keep',      displayValue: this.textBordersKeep},
+                    {value: 'none',      displayValue: this.textBordersNone},
+                    {value: 'outline',   displayValue: this.textBordersOutline},
+                    {value: 'bottom',    displayValue: this.textBordersBottom},
+                    {value: 'topbottom', displayValue: this.textBordersTopBottom}
+                ]
+            });
+            this.cmbBorders.setValue('keep');
+
+            // ComboBox values cannot be null: -1 stands for the general alignment.
+            this.cmbHorAlign = new Common.UI.ComboBox({
+                el          : $('#cell-style-halign'),
+                cls         : 'input-group-nr',
+                style       : 'width: 150px;',
+                menuStyle   : 'min-width: 150px;',
+                editable    : false,
+                data        : [
+                    {value: -1,                      displayValue: this.textGeneral},
+                    {value: AscCommon.align_Left,    displayValue: this.textLeft},
+                    {value: AscCommon.align_Center,  displayValue: this.textCenter},
+                    {value: AscCommon.align_Right,   displayValue: this.textRight},
+                    {value: AscCommon.align_Justify, displayValue: this.textJustify}
+                ]
+            });
+
+            this.cmbVertAlign = new Common.UI.ComboBox({
+                el          : $('#cell-style-valign'),
+                cls         : 'input-group-nr',
+                style       : 'width: 150px;',
+                menuStyle   : 'min-width: 150px;',
+                editable    : false,
+                data        : [
+                    {value: Asc.c_oAscVAlign.Top,    displayValue: this.textTop},
+                    {value: Asc.c_oAscVAlign.Center, displayValue: this.textMiddle},
+                    {value: Asc.c_oAscVAlign.Bottom, displayValue: this.textBottom}
+                ]
+            });
+
+            this.chWrap = new Common.UI.CheckBox({
+                el          : $('#cell-style-wrap'),
+                labelText   : this.textWrap
+            });
+
+            this.txtFormat = new Common.UI.InputField({
+                el          : $('#cell-style-format'),
+                style       : 'width: 200px;',
+                editable    : false
+            });
+            this.btnFormat = new Common.UI.Button({
+                el: $('#cell-style-format-change')
+            });
+            this.btnFormat.on('click', _.bind(this.onChangeFormat, this));
+
+            this.afterRender();
+        },
+
+        createToggle: function(parent, icon, hint) {
+            return new Common.UI.Button({
+                parentEl    : $(parent),
+                cls         : 'btn-toolbar',
+                iconCls     : 'toolbar__icon ' + icon,
+                enableToggle: true,
+                hint        : hint
+            });
+        },
+
+        createColorButton: function(parent, icon, hint, transparent) {
+            var button = new Common.UI.ButtonColored({
+                parentEl    : $(parent),
+                cls         : 'btn-toolbar',
+                iconCls     : 'toolbar__icon ' + icon,
+                hint        : hint,
+                additionalAlign: this.menuAddAlign,
+                color       : '000000',
+                transparent : transparent,
+                menu        : true,
+                takeFocusOnClose: true
+            });
+            button.setMenu();
+            button.colorPicker = button.getPicker();
+            button.on('color:select', function(btn, color) {
+                btn.currentColor = color;
+                btn.colorPicker.currentColor = color;
+                btn.isColorChanged = true;
+            });
+            return button;
+        },
+
+        getFocusedComponents: function() {
+            return [this.txtName, this.cmbFont, this.cmbFontSize, this.btnBold, this.btnItalic, this.btnUnderline,
+                this.btnTextColor, this.btnFillColor, this.cmbBorders, this.cmbHorAlign, this.cmbVertAlign, this.chWrap,
+                this.btnFormat].concat(this.getFooterButtons());
+        },
+
+        getDefaultFocusableComponent: function () {
+            return this.isModify ? this.cmbFont : this.txtName;
+        },
+
+        afterRender: function() {
+            var xfs = this.xfs;
+            this.cmbFont.fillFonts(this.fontStore);
+            this.txtName.setValue(this.name);
+
+            this.fontName = xfs.asc_getFontName();
+            this.cmbFont.setValue(this.fontName);
+            this.cmbFontSize.setValue(xfs.asc_getFontSize());
+            this.btnBold.toggle(!!xfs.asc_getFontBold(), true);
+            this.btnItalic.toggle(!!xfs.asc_getFontItalic(), true);
+            this.btnUnderline.toggle(!!xfs.asc_getFontUnderline(), true);
+
+            this.setButtonColor(this.btnTextColor, xfs.asc_getFontColor());
+            this.setButtonColor(this.btnFillColor, xfs.asc_getFillColor());
+
+            var horAlign = xfs.asc_getHorAlign();
+            this.cmbHorAlign.setValue(horAlign === null || horAlign === undefined ? -1 : horAlign);
+            this.cmbVertAlign.setValue(xfs.asc_getVertAlign());
+            this.chWrap.setValue(!!xfs.asc_getWrapText(), true);
+
+            this.format = xfs.asc_getNumFormat();
+            this.formatInfo = xfs.asc_getNumFormatInfo();
+            this.txtFormat.setValue(this.format);
+
+            this.initial = this.getControlValues();
+        },
+
+        // Same color handling as the conditional formatting dialog (FormatRulesEditDlg).
+        setButtonColor: function(button, color) {
+            var picker = button.colorPicker;
+            picker.updateColors(Common.Utils.ThemeColor.getEffectColors(), Common.Utils.ThemeColor.getStandartColors());
+            if (color && !color.get_auto()) {
+                if (color.get_type() == Asc.c_oAscColor.COLOR_TYPE_SCHEME) {
+                    color = {color: Common.Utils.ThemeColor.getHexColor(color.get_r(), color.get_g(), color.get_b()), effectValue: color.get_value()};
+                } else {
+                    color = Common.Utils.ThemeColor.getHexColor(color.get_r(), color.get_g(), color.get_b());
+                }
+            } else {
+                color = picker.options.transparent ? 'transparent' : '000000';
+            }
+            button.setColor(color);
+            Common.Utils.ThemeColor.selectPickerColorByEffect(color, picker);
+            picker.currentColor = color;
+            button.currentColor = color;
+        },
+
+        getControlValues: function() {
+            return {
+                fontName: this.fontName,
+                fontSize: Common.Utils.String.parseFloat(this.cmbFontSize.getRawValue()),
+                bold: this.btnBold.pressed,
+                italic: this.btnItalic.pressed,
+                underline: this.btnUnderline.pressed,
+                horAlign: this.cmbHorAlign.getValue(),
+                vertAlign: this.cmbVertAlign.getValue(),
+                wrap: this.chWrap.getValue() === 'checked',
+                format: this.format
+            };
+        },
+
+        onChangeFormat: function() {
+            var me = this;
+            (new Common.Views.FormatSettingsDialog({
+                api: me.api,
+                props: {format: me.format, formatInfo: me.formatInfo, langId: me.langId},
+                handler: function(result, settings) {
+                    if (result !== 'ok' || !settings) {
+                        return;
+                    }
+                    me.format = settings.format;
+                    me.txtFormat.setValue(settings.format);
+                }
+            })).show();
+        },
+
+        isNameValid: function() {
+            if (this.isModify) {
+                return true;
+            }
+            var check = this.api.asc_checkCellStyleName(this.txtName.getValue().trim());
+            if (check === Asc.c_oAscError.ID.No) {
+                return true;
+            }
+            var error = (check === Asc.c_oAscError.ID.CellStyleNameExists) ? this.textNameExists : this.textNameEmpty;
+            this.txtName.showError([error]);
+            this.txtName.cmpEl.find('input').focus();
+            return false;
+        },
+
+        getBorders: function(type) {
+            var line = new Asc.asc_CBorder(Asc.c_oAscBorderStyles.Thin, Common.Utils.ThemeColor.getRgbColor('000000'));
+            var borders = [];
+            if (type === 'outline' || type === 'topbottom') {
+                borders[Asc.c_oAscBorderOptions.Top] = line;
+            }
+            if (type === 'outline' || type === 'bottom' || type === 'topbottom') {
+                borders[Asc.c_oAscBorderOptions.Bottom] = line;
+            }
+            if (type === 'outline') {
+                borders[Asc.c_oAscBorderOptions.Left] = line;
+                borders[Asc.c_oAscBorderOptions.Right] = line;
+            }
+            return borders;
+        },
+
+        // Sets on the xfs only what changed in the dialog.
+        getSettings: function() {
+            var xfs = this.xfs;
+            var initial = this.initial;
+            var current = this.getControlValues();
+
+            if (current.fontName && current.fontName !== initial.fontName) {
+                xfs.asc_setFontName(current.fontName);
+            }
+            if (current.fontSize >= 1 && current.fontSize <= 409 && current.fontSize !== initial.fontSize) {
+                xfs.asc_setFontSize(current.fontSize);
+            }
+            if (current.bold !== initial.bold) {
+                xfs.asc_setFontBold(current.bold);
+            }
+            if (current.italic !== initial.italic) {
+                xfs.asc_setFontItalic(current.italic);
+            }
+            if (current.underline !== initial.underline) {
+                xfs.asc_setFontUnderline(current.underline);
+            }
+            if (this.btnTextColor.isColorChanged) {
+                xfs.asc_setFontColor(Common.Utils.ThemeColor.getRgbColor(this.btnTextColor.currentColor));
+            }
+            if (this.btnFillColor.isColorChanged) {
+                var fill = this.btnFillColor.currentColor;
+                xfs.asc_setFillColor(fill === 'transparent' ? null : Common.Utils.ThemeColor.getRgbColor(fill));
+            }
+            var borders = this.cmbBorders.getValue();
+            if (borders !== 'keep') {
+                xfs.asc_setBorder(this.getBorders(borders));
+            }
+            if (current.horAlign !== initial.horAlign) {
+                xfs.asc_setHorAlign(current.horAlign === -1 ? null : current.horAlign);
+            }
+            if (current.vertAlign !== initial.vertAlign) {
