+/**
+ * The numbering text of the level without the text before its first number and after its last one:
+ * "Chapter %1." gives "1", "%1.%2." gives "1.2"
+ * @param nLvl {number} 0..8
+ * @param oNumInfo
+ * @param [oLang] {AscCommonWord.CLang}
+ * @returns {string}
+ */
+CNum.prototype.GetTextWithoutAffixes = function(nLvl, oNumInfo, oLang)
+{
+	var oLvl    = this.GetLvl(nLvl);
+	var arrText = oLvl.GetLvlText();
+
+	var nFirst = -1, nLast = -1;
+	for (var Index = 0; Index < arrText.length; Index++)
+	{
+		if (numbering_lvltext_Num === arrText[Index].Type)
+		{
+			if (-1 === nFirst)
+				nFirst = Index;
+
+			nLast = Index;
+		}
+	}
+
+	var sResult = "";
+	if (-1 === nFirst)
+		return sResult;
+
+	for (Index = nFirst; Index <= nLast; Index++)
+	{
+		if (numbering_lvltext_Text === arrText[Index].Type)
+		{
+			sResult += arrText[Index].Value;
+		}
+		else if (numbering_lvltext_Num === arrText[Index].Type)
+		{
+			var nCurLvl = arrText[Index].Value;
+			if (nCurLvl < oNumInfo.length)
+				sResult += this.private_GetNumberedLvlText(nCurLvl, oNumInfo[nCurLvl], oLvl.IsLegalStyle(), oLang);
+		}
+	}
+
+	return sResult;
+};
