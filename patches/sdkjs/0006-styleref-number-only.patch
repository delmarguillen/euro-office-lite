+/**
+ * The numbering text of the paragraph without the text around its numbers ("Chapter 1." gives "1")
+ * @returns {string}
+ */
+Paragraph.prototype.GetNumberingTextWithoutAffixes = function()
+{
+	var oParent = this.GetParent();
+	var oNumPr  = this.GetNumPr();
+
+	if (!oNumPr || !oParent || -1 === this.GetIndex())
+		return "";
+
+	var oNum = oParent.GetNumbering().GetNum(oNumPr.NumId);
+	if (!oNum)
+		return "";
+
+	return oNum.GetTextWithoutAffixes(oNumPr.Lvl, oParent.CalculateNumberingValues(this, oNumPr), this.GetNumberingTextPr().Lang);
+};
