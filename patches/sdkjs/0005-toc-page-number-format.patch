+/**
+ * The number of the page in the number format of its section (w:pgNumType w:fmt), as the PAGE field shows it
+ * @param nPageAbs {number}
+ * @returns {string}
+ */
+CComplexField.prototype.private_GetPageNumText = function(nPageAbs)
+{
+	var oPageNumInfo = this.LogicDocument.Get_SectionPageNumInfo2(nPageAbs);
+	var oSectPr      = oPageNumInfo.Invalid ? null : this.LogicDocument.GetSections().GetSectPrByIndex(oPageNumInfo.SectIndex);
+	var nNumFormat   = oSectPr ? oSectPr.GetPageNumFormat() : Asc.c_oAscNumberingFormat.Decimal;
+	var sResult      = AscCommon.IntToNumberFormat(oPageNumInfo.CurPage, nNumFormat, {isFromField : true, isSkipFractPart : true});
+
+	// A format gives no text for a number it cannot show (0 in roman)
+	return "" === sResult ? "" + oPageNumInfo.CurPage : sResult;
+};
