{
  "identifier": "default",
  "description": "Default capabilities for Euro-Office",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "shell:allow-open",
    "shell:default",
    "allow-open-file",
    "allow-open-pdf",
    "allow-save-file",
    "allow-save-file-as",
    "allow-write-editor-bin",
    "allow-print-document",
    "allow-create-new",
    "allow-get-current-path",
    "allow-pick-image-files",
    "allow-take-pending-open-file",
